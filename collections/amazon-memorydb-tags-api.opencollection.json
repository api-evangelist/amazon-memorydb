{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon MemoryDB ACLs Tags API",
    "version": "2021-01-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon MemoryDB ListTags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://memory-db.us-east-1.amazonaws.com/tags"
          },
          "docs": "Lists all tags currently on a named resource."
        },
        {
          "info": {
            "name": "Amazon MemoryDB TagResource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://memory-db.us-east-1.amazonaws.com/tags",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "A tag is a key-value pair where the key and value are case-sensitive."
        },
        {
          "info": {
            "name": "Amazon MemoryDB UntagResource",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://memory-db.us-east-1.amazonaws.com/tags"
          },
          "docs": "Use this operation to remove tags on a resource."
        }
      ]
    }
  ],
  "bundled": true
}