{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon MemoryDB ACLs ReservedNodes API",
    "version": "2021-01-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ReservedNodes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon MemoryDB DescribeReservedNodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://memory-db.us-east-1.amazonaws.com/reservednodes"
          },
          "docs": "Returns information about reserved nodes for this account."
        },
        {
          "info": {
            "name": "Amazon MemoryDB PurchaseReservedNodesOffering",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://memory-db.us-east-1.amazonaws.com/reservednodes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Allows you to purchase a reserved node offering."
        },
        {
          "info": {
            "name": "Amazon MemoryDB DescribeReservedNodesOfferings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://memory-db.us-east-1.amazonaws.com/reservednodes/describereservednodesofferings"
          },
          "docs": "Lists available reserved node offerings."
        }
      ]
    }
  ],
  "bundled": true
